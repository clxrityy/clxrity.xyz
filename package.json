{
    "name": "img.clxrity.xyz",
    "version": "0.1.0",
    "private": true,
    "description": "Personal image upload CLI for img.clxrity.xyz backed by Cloudflare R2.",
    "type": "module",
    "bin": {
        "clxrity-img": "./dist/cli.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.17.1",
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
        "typecheck": "tsc --noEmit",
        "test": "pnpm build && vitest run",
        "test:watch": "vitest",
        "check": "pnpm typecheck && pnpm test",
        "verify:package": "pnpm build && node scripts/verify-package.mjs",
        "img": "tsx src/cli.ts",
        "upload": "tsx src/cli.ts upload",
        "list": "tsx src/cli.ts list",
        "remove": "tsx src/cli.ts remove"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1152.0",
        "commander": "14.0.3",
        "dotenv": "17.4.2",
        "sharp": "0.34.5"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vitest": "3.2.7"
    }
}